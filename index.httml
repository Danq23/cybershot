<!DOCTYPE html>
<html lang="ro"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#c4c8ce">
<title>CyberShot Web</title>
<style>
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{background:#c4c8ce;color:#1d2126;font:15px/1.35 system-ui,sans-serif;padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}
main{display:flex;flex-direction:column;gap:12px;height:100%;max-width:560px;margin:auto;padding:12px}
.lcd{position:relative;flex:1;min-height:0;background:#0c1a24;border:6px solid #8b9098;border-radius:10px;overflow:hidden}
video{width:100%;height:100%;object-fit:contain;display:block}
#msg{position:absolute;left:0;right:0;bottom:0;padding:8px 10px;color:#bfe3ff;background:#0c1a24cc;font-size:13px}
#msg:empty{display:none}
#go{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);padding:14px 22px;border:0;border-radius:8px;background:#e2461b;color:#fff;font:600 16px system-ui}
#go[hidden]{display:none}
#fl{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none}
#fl.on{opacity:1;transition:none}#fl{transition:opacity .25s}
.fx,.opts{display:flex;flex-wrap:wrap;gap:6px}
.fx label{cursor:pointer}
.fx input,.opts input[type=checkbox]{position:absolute;opacity:0}
.fx span{display:block;padding:7px 11px;border:2px solid #8b9098;border-radius:6px;background:#dfe2e6}
.fx input:checked+span{background:#0c1a24;border-color:#0c1a24;color:#bfe3ff}
.fx input:focus-visible+span,button:focus-visible{outline:3px solid #e2461b;outline-offset:2px}
.opts{align-items:center;font-size:13px}
.opts label{display:flex;align-items:center;gap:5px}
.opts input[type=checkbox]{position:static;opacity:1;width:18px;height:18px}
.opts input[type=range]{width:110px}
select{padding:5px;border-radius:5px;border:2px solid #8b9098;background:#dfe2e6}
.bar{display:flex;align-items:center;justify-content:space-between}
.bar button.sm{padding:10px 14px;border:2px solid #8b9098;border-radius:8px;background:#dfe2e6;font:inherit}
#shot{width:76px;height:76px;border-radius:50%;border:6px solid #8b9098;background:#e2461b;box-shadow:inset 0 -6px #0003}
#shot:active{transform:scale(.94)}
#gf{min-width:70px;text-align:right;font-variant-numeric:tabular-nums}
#out{position:fixed;inset:0;background:#0c1a24f2;display:flex;flex-direction:column;gap:12px;padding:14px;align-items:center}
#out[hidden]{display:none}
#out img{flex:1;min-height:0;max-width:100%;object-fit:contain}
#out p{color:#bfe3ff;font-size:13px;text-align:center}
.act{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.act a,.act button{padding:12px 18px;border-radius:8px;border:0;background:#e2461b;color:#fff;font:600 15px system-ui;text-decoration:none}
.act .alt{background:#dfe2e6;color:#1d2126}
@media(prefers-reduced-motion:reduce){#fl{transition:none}}
</style></head><body>
<main>
 <div class="lcd"><video id="v" playsinline muted autoplay></video><div id="fl"></div><button id="go">Pornește camera</button><div id="msg"></div></div>
 <div class="fx" id="fx">
  <label><input type="checkbox" name="dqt"><span>Cuantizare</span></label>
  <label><input type="checkbox" name="scan"><span>Transplant scan</span></label>
  <label><input type="checkbox" name="chroma"><span>Croma</span></label>
  <label><input type="checkbox" name="zigzag"><span>Zigzag</span></label>
  <label><input type="checkbox" name="dht"><span>Huffman</span></label>
 </div>
 <div class="opts">
  <label><input type="checkbox" id="auto" checked>Intensitate după lumină</label>
  <input type="range" id="int" min="5" max="95" value="50" aria-label="Intensitate">
  <select id="size" aria-label="Rezoluție"><option value="1024">1024 px</option><option value="1920">1920 px</option><option value="9999">Maxim</option></select>
  <label><input type="checkbox" id="ad">Descarcă automat</label>
  <button class="sm" id="gal" style="padding:6px 10px;border:2px solid #8b9098;border-radius:6px;background:#dfe2e6;font:inherit">Din galerie</button>
  <input type="file" id="cam" accept="image/*" capture="environment" hidden>
  <input type="file" id="pick" accept="image/*" hidden>
 </div>
 <div class="bar">
  <button class="sm" id="flip">Întoarce camera</button>
  <button id="shot" aria-label="Fă poza"></button>
  <span id="gf"></span>
 </div>
</main>
<section id="out" hidden>
 <img id="img" alt="Poza făcută">
 <p id="note"></p>
 <div class="act"><a id="dl" href="#">Descarcă</a><button id="sh" class="alt" hidden>Trimite</button><button id="back" class="alt">Înapoi la cameră</button></div>
</section>
<script>
const $=id=>document.getElementById(id);
let stream,facing='environment',url=null;
const msg=t=>$('msg').textContent=t;

async function start(){
  if(stream)stream.getTracks().forEach(t=>t.stop());
  stream=null;
  const go=$('go');go.hidden=true;
  const where=' ['+location.protocol+'//'+(location.host||'fișier')+']';
  if(!navigator.mediaDevices){
    msg('Camera live nu e disponibilă pe această adresă. Apasă butonul roșu: se deschide aplicația camerei, iar poza primește efectele.'+where);return}
  try{
    stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:facing,width:{ideal:1920},height:{ideal:1080}},audio:false});
    $('v').srcObject=stream;msg('');
  }catch(e){
    go.hidden=false;go.textContent='Încearcă din nou';
    const h={
      NotAllowedError:'Acces refuzat. Atinge pictograma din bara de adrese → Permisiuni → Cameră → Permite. Verifică și Setări Android → Aplicații → browser → Permisiuni → Cameră.',
      NotFoundError:'Nu s-a găsit nicio cameră.',
      NotReadableError:'Altă aplicație folosește camera. Închide-o și încearcă din nou.',
      OverconstrainedError:'Camera cerută nu există. Apasă „Întoarce camera".'};
    msg((h[e.name]||'Eroare: '+e.name)+' Butonul roșu deschide aplicația camerei.'+where);
  }
}

// ── JPEG: parcurge markerii până la SOS; segmentele conțin doar antete, nu date de scan
function parse(b){
  const segs=[];let i=2;
  while(i<b.length-3){
    if(b[i]!==0xFF){i++;continue}
    const m=b[i+1];
    if(m===0xFF){i++;continue}
    if(m===0xD8||m===0x01||(m>=0xD0&&m<=0xD7)){i+=2;continue}
    const len=(b[i+2]<<8)|b[i+3];
    if(m===0xDA){let e=b.length-2;while(e>i&&!(b[e]===0xFF&&b[e+1]===0xD9))e--;return{segs,a:i+2+len,z:e}}
    segs.push({m,s:i+4,e:i+2+len});i+=2+len;
  }
  return{segs,a:-1,z:-1};
}
function eachDQT(b,p,fn){
  for(const g of p.segs)if(g.m===0xDB){
    let q=g.s;
    while(q<g.e){const prec=b[q]>>4,id=b[q]&15;if(prec){q+=129;continue}fn(q+1,id);q+=65}
  }
}
// ── Efectele din main.cpp, portate; g = intensitate 0..1
const F={
  dqt(b,p,g){const lo=Math.floor(g*19),hi=63-Math.floor(g*31);
    eachDQT(b,p,q=>{for(let k=1;k<64;k++){if(k<=lo)b[q+k]=1;else if(k>=hi)b[q+k]=255}})},
  chroma(b,p,g){let has=false;eachDQT(b,p,(q,id)=>{if(id===1)has=true});
    const hi=18+Math.floor(g*10),dc=162+Math.floor(g*18),ac=198+Math.floor(g*32);
    eachDQT(b,p,(q,id)=>{if(has&&id!==1)return;b[q]=dc;for(let k=4;k<=hi;k++)b[q+k]=ac})},
  zigzag(b,p,g){const r=4+Math.floor(g*37);
    eachDQT(b,p,q=>{const t=b.slice(q+1,q+64);for(let k=0;k<63;k++)b[q+1+k]=t[(k+r)%63]})},
  dht(b,p,g){const rl=Math.min(6,1+Math.floor(g*5)),rc=Math.max(1,Math.min(3,rl-1));
    for(const sg of p.segs)if(sg.m===0xC4){
      let q=sg.s;
      while(q<sg.e){
        const cls=b[q]>>4,id=b[q]&15;q++;
        let n=0;for(let k=0;k<16;k++)n+=b[q+k];q+=16;
        if(cls===1&&n>1){
          const rot=id===0?rl:rc;
          for(let sz=1;sz<=10;sz++){
            const idx=[];for(let k=0;k<n&&idx.length<16;k++)if((b[q+k]&15)===sz)idx.push(k);
            const gn=idx.length;if(gn<2)continue;
            const val=idx.map(k=>b[q+k]),sr=Math.max(1,Math.min(gn-1,Math.floor(rot*sz/5)));
            idx.forEach((k,j)=>b[q+k]=val[(j+sr)%gn]);
          }
        }
        q+=n;
      }
    }},
  scan(b,p,g){const{a,z}=p,L=z-a;if(a<0||L<512)return;
    const r=crypto.getRandomValues(new Uint8Array(3));
    const n=2+r[0]%3,div=8+r[1]%11,dp=25+r[2]%26;
    const tl=Math.max(64,Math.min(4096,Math.floor(L/div))),off=Math.floor(L*dp/100);
    for(let t=0;t<n;t++){
      const s=a+Math.floor((t/n+g*0.6/n)*(L-tl)),d=a+((s-a+off)%L);
      let l=tl;if(s+l>z)l=z-s;
      if(l>0&&d+l<=z)b.copyWithin(s,d,d+l);
    }}
};
const ORDER=['zigzag','dqt','dht','scan','chroma'];

// ── Captură: cadru → canvas → JPEG → glitch pe octeți
function grab(src,w,h){
  const cap=+$('size').value;
  if(!w)return Promise.reject(new Error('Camera nu e gata'));
  if(w>cap){h=Math.round(h*cap/w);w=cap}
  const c=document.createElement('canvas');c.width=w;c.height=h;
  c.getContext('2d').drawImage(src,0,0,w,h);
  const t=document.createElement('canvas');t.width=32;t.height=24;
  const tx=t.getContext('2d');tx.drawImage(c,0,0,32,24);
  const d=tx.getImageData(0,0,32,24).data;let L=0;
  for(let i=0;i<d.length;i+=4)L+=.299*d[i]+.587*d[i+1]+.114*d[i+2];
  return new Promise(r=>c.toBlob(bl=>r({bl,luma:L/768}),'image/jpeg',.85));
}
async function shoot(){
  if(!stream){$('cam').click();return}
  const fl=$('fl');fl.classList.add('on');setTimeout(()=>fl.classList.remove('on'),60);
  let cap;try{cap=await grab($('v'),$('v').videoWidth,$('v').videoHeight)}catch(e){msg(e.message);return}
  await process(cap);
}
async function fromFile(f){
  if(!f)return;
  try{const bm=await createImageBitmap(f);const cap=await grab(bm,bm.width,bm.height);if(bm.close)bm.close();await process(cap)}
  catch(e){msg('Nu pot citi poza ('+e.name+').')}
}
async function process(cap){
  const orig=new Uint8Array(await cap.bl.arrayBuffer());
  const g=$('auto').checked?Math.min(.95,Math.max(.05,1-cap.luma/255)):$('int').value/100;
  $('gf').textContent='FX '+Math.round(g*100)+'%';
  const on=[...document.querySelectorAll('#fx input:checked')].map(i=>i.name);
  let out=orig,ok=!on.length;
  for(let n=0;n<5&&!ok;n++){           // reîncearcă dacă JPEG-ul iese prea corupt
    const b=orig.slice(),p=parse(b);
    for(const k of ORDER)if(on.includes(k))F[k](b,p,g);
    try{await createImageBitmap(new Blob([b],{type:'image/jpeg'}));out=b;ok=true}catch(e){}
  }
  show(new Blob([out],{type:'image/jpeg'}),on.length&&!ok);
}
function show(blob,failed){
  if(url)URL.revokeObjectURL(url);
  url=URL.createObjectURL(blob);
  const ts=new Date().toISOString().replace(/[-:T]/g,'').slice(0,14),name='cybershot_'+ts+'.jpg';
  $('img').src=url;$('dl').href=url;$('dl').download=name;
  $('note').textContent=failed?'Efectele au stricat prea tare imaginea de 5 ori; ai poza fără efecte. Scade intensitatea și încearcă din nou.':name;
  const f=new File([blob],name,{type:'image/jpeg'});
  $('sh').hidden=!(navigator.canShare&&navigator.canShare({files:[f]}));
  $('sh').onclick=()=>navigator.share({files:[f]}).catch(()=>{});
  $('out').hidden=false;
  if($('ad').checked)$('dl').click();
}
$('shot').onclick=shoot;
$('back').onclick=()=>$('out').hidden=true;
$('flip').onclick=()=>{facing=facing==='environment'?'user':'environment';$('cam').setAttribute('capture',facing);start()};
const onFile=e=>{const f=e.target.files[0];e.target.value='';fromFile(f)};
$('cam').onchange=onFile;$('pick').onchange=onFile;
$('gal').onclick=()=>$('pick').click();
$('auto').onchange=()=>$('int').disabled=$('auto').checked;$('int').disabled=true;
$('go').onclick=start;
if(navigator.permissions&&navigator.permissions.query){
  navigator.permissions.query({name:'camera'}).then(r=>{
    if(r.state==='granted')start();
    else if(r.state==='denied')msg('Camera e blocată pentru acest site. Schimbă din pictograma din bara de adrese → Permisiuni → Cameră → Permite, apoi apasă butonul.');
    r.onchange=()=>{if(r.state==='granted')start()};
  }).catch(()=>{});
}
</script></body></html>
